<group name="vuln_hospital,">

  <!-- SSRF: 앱 요청 로그의 url 파라미터가 내부망/클라우드 메타데이터 주소를 가리킴 -->
  <rule id="100010" level="0">
    <decoded_as>hospital-app-event</decoded_as>
    <field name="event">app_request</field>
    <description>vuln-hospital-booking application request log</description>
  </rule>

  <!-- 100011: 범용 1차 탐지. query_string 안의 url= 파라미터가 내부망/루프백/클라우드
       메타데이터 주소를 가리키면 발화. 흔한 IP 난독화 우회(10진수/16진수/8진수 표기,
       IPv6 루프백·매핑주소, ECS 메타데이터 169.254.170.2 등)도 함께 커버한다.
       curl 의 data urlencode 옵션은 "/", ":" 등만 퍼센트 인코딩하고 IP의 점(.)과
       10진수/16진수 문자는 그대로 두므로, query_string(원문 그대로 로깅됨)에서
       인코딩 여부와 무관하게 매칭된다. -->
  <rule id="100011" level="10">
    <if_sid>100010</if_sid>
    <field name="query_string" type="pcre2">(?i)url=.*(169\.254\.169\.254|169\.254\.170\.2|127\.\d{1,3}\.\d{1,3}\.\d{1,3}|0\.0\.0\.0|localhost|10\.\d{1,3}\.\d{1,3}\.\d{1,3}|172\.(1[6-9]|2\d|3[01])\.\d{1,3}\.\d{1,3}|192\.168\.\d{1,3}\.\d{1,3}|::1|::ffff:169\.254\.169\.254|2852039166|0x[aA]9[fF][eE][aA]9[fF][eE]|0251\.0376\.0251\.0376)</field>
    <description>SSRF suspected: fetched url parameter targets internal network or cloud metadata address (incl. common IP-obfuscation bypasses)</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>ssrf,</group>
  </rule>

  <!-- 100012: 실제 취약 엔드포인트(/documents/referral-link-preview,
       /api/documents/referral-link-preview - app/routes/user_pages.py,
       app/routes/api.py 의 requests.get(url) 무검증 호출)로 좁혀 확증도를 높인 룰.
       100011의 두 조건(내부/메타데이터 목적지) + 알려진 취약 경로가 모두 맞아야
       발화하므로 다른 화면의 우연한 "url=" 파라미터로 인한 오탐을 줄인다. -->
  <rule id="100012" level="12">
    <if_sid>100011</if_sid>
    <field name="path" type="pcre2">(?i)/documents/referral-link-preview$</field>
    <description>SSRF exploit attempt against known-vulnerable referral-link-preview endpoint: $(query_string)</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>ssrf,attack_scenario,</group>
  </rule>

  <!-- 100013: EC2 IMDS IAM 임시 자격증명 조회 경로(iam/security-credentials/<role>)까지
       특정한 요청 - ssrf_steal_ec2_creds.sh 가 실제로 보내는 패턴과 일치.
       curl 의 G 옵션과 data urlencode 옵션으로 슬래시가 %2F 로 인코딩돼도 "security-credentials"
       문자열 자체(하이픈/영문자만 구성)는 인코딩되지 않으므로 그대로 매칭된다. -->
  <rule id="100013" level="14">
    <if_sid>100012</if_sid>
    <field name="query_string" type="pcre2">(?i)169\.254\.169\.254.*security-credentials</field>
    <description>SSRF -> EC2 IMDS IAM role credential theft attempt: $(query_string)</description>
    <mitre>
      <id>T1552.005</id>
    </mitre>
    <group>ssrf,credential_access,critical,</group>
  </rule>

  <!-- 100014: 위 요청이 HTTP 200으로 응답됨 - 자격증명이 실제로 애플리케이션 응답에
       담겨 반환(탈취 성공)됐을 가능성이 높은 확증 단계. -->
  <rule id="100014" level="15">
    <if_sid>100013</if_sid>
    <field name="status_code">^200$</field>
    <description>SSRF -> EC2 IMDS credential theft CONFIRMED (HTTP 200 on $(path)): IAM role credentials likely exfiltrated</description>
    <mitre>
      <id>T1552.005</id>
    </mitre>
    <group>ssrf,credential_access,critical,</group>
  </rule>

  <!-- S3 대량 다운로드(sync)를 통한 외부 유출 -->
  <!-- Wazuh 기본 룰 80200(decoded_as json + integration=aws)의 자식으로 체이닝해야 한다.
       decoded_as만으로 독립된 top-level 룰을 만들면 80200이 먼저 매칭을 가져가버려서
       이 룰은 절대 평가되지 않는다(같은 로그당 하나의 룰 트리만 따라감). -->
  <rule id="100020" level="3">
    <if_sid>80200</if_sid>
    <field name="aws.eventName">^GetObject$</field>
    <field name="aws.requestParameters.bucketName" type="pcre2">-documents-</field>
    <description>Document bucket object download (GetObject)</description>
    <group>s3_exfil,</group>
  </rule>

  <rule id="100021" level="12" frequency="5" timeframe="120">
    <if_matched_sid>100020</if_matched_sid>
    <same_field>aws.userIdentity.arn</same_field>
    <description>Bulk document bucket download by same identity in short window - s3 sync exfil suspected</description>
    <mitre>
      <id>T1530</id>
    </mitre>
    <group>s3_exfil,</group>
  </rule>

  <!-- SSE-C 커스텀 키 재암호화 (Codefinger 랜섬웨어 패턴) -->
  <rule id="100030" level="12">
    <if_sid>80200</if_sid>
    <field name="aws.eventName">^PutObject$</field>
    <field name="aws.requestParameters.x-amz-server-side-encryption-customer-algorithm" type="pcre2">.+</field>
    <description>S3 object re-encrypted with SSE-C customer key - Codefinger ransomware pattern</description>
    <mitre>
      <id>T1486</id>
    </mitre>
    <group>s3_ransomware,</group>
  </rule>

  <!-- 라이프사이클 정책 변경으로 자동삭제 설정 (복구 불능화).
       boto3 메서드명은 put_bucket_lifecycle_configuration이지만 CloudTrail
       eventName은 구버전 REST API 명칭인 PutBucketLifecycle로 기록된다
       (lookup_events로 실제 호출 후 확인함). -->
  <rule id="100031" level="10">
    <if_sid>80200</if_sid>
    <field name="aws.eventName">^PutBucketLifecycle$</field>
    <field name="aws.requestParameters.bucketName" type="pcre2">-documents-</field>
    <description>Document bucket lifecycle policy changed - possible SSE-C ransomware auto-delete stage</description>
    <mitre>
      <id>T1485</id>
    </mitre>
    <group>s3_ransomware,</group>
  </rule>

  <!-- 100032: 상관분석 확증. 100031은 정상 운영(문서 자동 보관/만료 정책 설정)으로도
       뜰 수 있어 level을 낮게(10) 유지하는데, 같은 버킷에서 SSE-C 재암호화(100030)가
       먼저 있었고 짧은 시간 안에 lifecycle 변경(100031)까지 겹치면 정상 운영에서는
       나올 수 없는 조합이라 확실한 랜섬웨어 체인으로 본다. 이 로그는 100031이 아니라
       100032로 발화한다(같은 트리에서 더 깊은 룰이 우선). timeframe 600초는 스크립트로
       여러 객체를 순차 재암호화한 뒤 바로 lifecycle을 설정하는 통상적인 소요시간을 감안. -->
  <rule id="100032" level="15" timeframe="600">
    <if_sid>100031</if_sid>
    <if_matched_sid>100030</if_matched_sid>
    <same_field>aws.requestParameters.bucketName</same_field>
    <description>SSE-C 랜섬웨어 체인 확증: 같은 버킷에서 SSE-C 재암호화 직후 lifecycle 자동삭제 설정 - 정상 운영에서는 나올 수 없는 조합</description>
    <mitre>
      <id>T1486</id>
      <id>T1485</id>
    </mitre>
    <group>s3_ransomware,attack_scenario,critical,</group>
  </rule>

  <!-- 100033: SSE-C 키로 조회(반출). 정상 앱은 SSE-C 커스텀 키를 모르므로
       GetObject에 x-amz-server-side-encryption-customer-algorithm 헤더가 실리는
       경우는 없다 - 공격자 본인이 재암호화한 객체를 자기 키로 다시 읽어가는
       경우(lifecycle 자동삭제 전 사본 확보, 이중공갈용)에만 발화하는 단일 이벤트
       확정 신호. 100020/100021(볼륨 기반 대량 다운로드 탐지)과 달리 속도에
       관계없이 이 패턴 자체로 확정된다. -->
  <rule id="100033" level="13">
    <if_sid>80200</if_sid>
    <field name="aws.eventName">^GetObject$</field>
    <field name="aws.requestParameters.bucketName" type="pcre2">-documents-</field>
    <field name="aws.requestParameters.x-amz-server-side-encryption-customer-algorithm" type="pcre2">.+</field>
    <description>SSE-C 커스텀 키로 문서 버킷 객체 조회 - 공격자가 자신이 재암호화한 사본을 반출하는 정황(Codefinger 이중공갈 패턴)</description>
    <mitre>
      <id>T1005</id>
      <id>T1486</id>
    </mitre>
    <group>s3_ransomware,s3_exfil,</group>
  </rule>

  <!-- 100034: 전체 체인 확증. 100032(재암호화+lifecycle 확증)가 같은 버킷에서
       이미 떴고, 그 뒤 SSE-C 키로 조회(100033)까지 일어나면 재암호화 -> 삭제
       예약 -> 반출까지 랜섬웨어 공격의 전 단계가 완결된 것으로 본다.
       timeframe은 100032와 동일하게 600초. -->
  <rule id="100034" level="15" timeframe="600">
    <if_sid>100033</if_sid>
    <if_matched_sid>100032</if_matched_sid>
    <same_field>aws.requestParameters.bucketName</same_field>
    <description>SSE-C 랜섬웨어 체인 완전 확증: 재암호화 -> lifecycle 자동삭제 설정 -> SSE-C 키로 반출까지 전 단계 완료</description>
    <mitre>
      <id>T1486</id>
      <id>T1485</id>
      <id>T1005</id>
    </mitre>
    <group>s3_ransomware,attack_scenario,critical,</group>
  </rule>

  <!-- ============================================================ -->
  <!-- CloudTrail/VPC Flow Logs 로깅 비활성화 탐지 (Defense Evasion)   -->
  <!-- 공격자가 침투 후 흔적을 지우려고 로깅을 끄거나 로그를 지우는 단계 -->
  <!-- ============================================================ -->

  <rule id="100040" level="12">
    <if_sid>80200</if_sid>
    <field name="aws.eventName">^StopLogging$</field>
    <description>CloudTrail logging stopped - defense evasion suspected</description>
    <mitre>
      <id>T1562.008</id>
    </mitre>
    <group>log_tampering,</group>
  </rule>

  <rule id="100041" level="12">
    <if_sid>80200</if_sid>
    <field name="aws.eventName">^DeleteTrail$</field>
    <description>CloudTrail trail deleted - defense evasion suspected</description>
    <mitre>
      <id>T1562.008</id>
    </mitre>
    <group>log_tampering,</group>
  </rule>

  <rule id="100042" level="9">
    <if_sid>80200</if_sid>
    <field name="aws.eventName">^UpdateTrail$</field>
    <description>CloudTrail trail configuration changed - verify multi-region/log validation settings were not weakened</description>
    <mitre>
      <id>T1562.008</id>
    </mitre>
    <group>log_tampering,</group>
  </rule>

  <rule id="100043" level="12">
    <if_sid>80200</if_sid>
    <field name="aws.eventName">^DeleteFlowLogs$</field>
    <description>VPC Flow Logs deleted - defense evasion suspected</description>
    <mitre>
      <id>T1562.008</id>
    </mitre>
    <group>log_tampering,</group>
  </rule>

  <rule id="100044" level="12">
    <if_sid>80200</if_sid>
    <field name="aws.eventName">^DeleteBucket$</field>
    <field name="aws.requestParameters.bucketName" type="pcre2">-logs-</field>
    <description>Log bucket deleted - CloudTrail/VPC Flow Log/GuardDuty evidence destruction suspected</description>
    <mitre>
      <id>T1562.008</id>
    </mitre>
    <group>log_tampering,</group>
  </rule>

  <rule id="100045" level="10">
    <if_sid>80200</if_sid>
    <field name="aws.eventName" type="pcre2">^(PutBucketPolicy|PutBucketAcl|DeletePublicAccessBlock)$</field>
    <field name="aws.requestParameters.bucketName" type="pcre2">-logs-</field>
    <description>Log bucket policy/ACL changed - possible attempt to expose or lock out access to log evidence</description>
    <mitre>
      <id>T1562.008</id>
    </mitre>
    <group>log_tampering,</group>
  </rule>

  <!-- ============================================================ -->
  <!-- VPC Flow Logs 기반 네트워크 이상탐지                            -->
  <!-- ============================================================ -->

  <!-- VPC Flow Log 레코드 식별용 베이스 룰. Wazuh 기본 룰셋의 vpcflow 전용 베이스(80400,
       aws.source=vpcflow)에 체이닝한다 - 80200에 직접 걸면 Wazuh 자체 vpcflow 룰(80400
       트리)이 먼저 그 이벤트를 가져가버려서 이 룰까지 평가가 내려오지 않는다. -->
  <rule id="100050" level="0">
    <if_sid>80400</if_sid>
    <field name="aws.action" type="pcre2">^(ACCEPT|REJECT)$</field>
    <description>AWS VPC Flow Log record</description>
    <group>vpcflow,</group>
  </rule>

  <!-- 포트 스캔/네트워크 정찰: 짧은 시간에 동일 출발지에서 다수의 REJECT 발생 -->
  <rule id="100051" level="3">
    <if_sid>100050</if_sid>
    <field name="aws.action">^REJECT$</field>
    <description>VPC Flow Log: connection rejected</description>
    <group>vpcflow,</group>
  </rule>

  <rule id="100052" level="10" frequency="15" timeframe="60">
    <if_matched_sid>100051</if_matched_sid>
    <same_field>aws.srcaddr</same_field>
    <description>Port scan / network reconnaissance suspected - many rejected connections from same source in short window</description>
    <mitre>
      <id>T1595</id>
    </mitre>
    <group>vpcflow,recon,</group>
  </rule>

  <!-- 대량 아웃바운드 유출 의심: 외부(사설 IP 대역이 아닌) 목적지로 대용량 전송 -->
  <rule id="100053" level="3">
    <if_sid>100050</if_sid>
    <field name="aws.action">^ACCEPT$</field>
    <description>VPC Flow Log: connection accepted</description>
    <group>vpcflow,</group>
  </rule>

  <rule id="100054" level="10">
    <if_sid>100053</if_sid>
    <field name="aws.bytes" type="pcre2">^\d{9,}$</field>
    <field name="aws.dstaddr" type="pcre2" negate="yes">^(10\.|172\.(1[6-9]|2\d|3[01])\.|192\.168\.)</field>
    <description>Large outbound data transfer to external address suspected - possible network-layer exfiltration</description>
    <mitre>
      <id>T1041</id>
    </mitre>
    <group>vpcflow,exfil,</group>
  </rule>

  <!-- 앱 서버 아웃바운드 화이트리스트(default-deny) 기반 이상탐지.
       앱 서버(hospital app EC2)는 역할이 고정된 백엔드라 평소 나가는 곳이 뻔하다:
       RDS(5432), Wazuh 매니저(1514/1515 에이전트 트래픽), 그리고 S3/패키지 저장소 등
       목적지 IP가 계속 바뀌는 대상에 대한 표준 웹/DNS 포트(80/443/53) 뿐이다.
       그 외 목적지/포트로 나가는 연결은 (C2 업로드처럼) 예상 밖의 반출 경로일 가능성이 높다.

       주의: 아래 IP들은 하드코딩된 값이라 인스턴스가 재생성되면(user_data_replace_on_change)
       바뀔 수 있다. 최신값 확인 방법:
         - 앱 서버 private IP: 매니저에서 `/var/ossec/bin/agent_control -l` (에이전트 이름 ip-10-0-1-xxx)
         - Wazuh 매니저 private IP: 매니저에서 `hostname -I`
         - RDS private IP: 같은 VPC 내부에서 RDS 엔드포인트를 dig/getent로 조회 (AWS 사설 DNS가 사설 IP로 응답)
       또한 443을 통짜로 허용하고 있어서, 공격자가 C2 리시버를 8080이 아니라 443으로 띄우면 이 룰은
       못 잡는다(포트 기반 근사치의 한계). 더 확실하게 하려면 S3 VPC 게이트움 엔드포인트를 붙여서
       S3 트래픽을 고정 prefix-list로 분리하는 방향을 고려할 것. -->
  <rule id="100055" level="10">
    <if_sid>100053</if_sid>
    <field name="aws.srcaddr">^10\.0\.1\.131$</field>
    <field name="aws.dstaddr" type="pcre2" negate="yes">^(10\.0\.2\.65|10\.0\.1\.76)$</field>
    <field name="aws.dstport" type="pcre2" negate="yes">^(443|80|53|5432|1514|1515)$</field>
    <description>Hospital app server egress to unexpected destination/port (possible exfiltration to unauthorized host): $(aws.dstaddr):$(aws.dstport)</description>
    <mitre>
      <id>T1041</id>
    </mitre>
    <group>vpcflow,exfil,egress_anomaly,</group>
  </rule>

</group>
